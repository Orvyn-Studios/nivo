{
  "identifier": "island",
  "description": "Finite island, preferences, displays, GSMTC and opt-in own startup entry commands; no general filesystem, shell or remote content.",
  "windows": [
    "island"
  ],
  "permissions": [
    "allow-ready",
    "allow-open-preferences",
    "allow-set-expanded",
    "allow-set-surface-geometry",
    "allow-set-companion-tracking",
    "allow-hide-island",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-displays",
    "allow-get-media-snapshot",
    "allow-get-audio-snapshot",
    "allow-get-power-snapshot",
    "allow-get-drop-snapshot",
    "allow-drop-action",
    "allow-cancel-drop-action",
    "allow-audio-control",
    "allow-open-sound-settings",
    "allow-media-control",
    "allow-quit-app",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-autostart",
    "allow-set-autostart"
  ]
}
